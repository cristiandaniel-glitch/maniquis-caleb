# Entornos virtuales de Python
.venv/
venv/
ENV/
env/

# Caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Bases de datos locales: nunca versionar datos de clientes o secretos.
database/*.db
database/*.sqlite3

# Variables de entorno y secretos
.env
.env.local

# Logs del sistema
*.log
npm-debug.log*
yarn-debug.log*

# Archivos del Sistema Operativo
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp

# SQLite runtime journal files
database/*.db-shm
database/*.db-wal

# Estado efímero de la caché de cada proceso
database/.api-cache-version
