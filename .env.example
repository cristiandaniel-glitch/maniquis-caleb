# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO: MANIQUÍES Y EXHIBIDORES CALEB
# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a Git.
# ==============================================================================

# Servidor
PORT=8000
HOST=0.0.0.0
DEBUG=False
# Procesos de trabajo (Linux/macOS). Vacío = uno por núcleo. En Windows siempre es 1.
WORKERS=

# Base de datos PostgreSQL (Supabase)
# Copia la cadena "Session pooler" desde Supabase > Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:TU_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSLMODE=require
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_TIMEOUT=10

# ------------------------------------------------------------------ Seguridad
# Credenciales del panel /admin. Se generan con:
#     python scripts/generar_clave_admin.py
# Sin estas tres líneas el panel queda BLOQUEADO (no hay contraseña por defecto).
ADMIN_SALT=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Otros dominios que pueden llamar a la API (separados por coma).
# Vacío = solo este mismo sitio, que es lo normal.
CORS_ALLOWED_ORIGINS=

# Peticiones por minuto y por IP (lecturas de la API / envío de formularios).
RATE_LIMIT_PER_MINUTE=300
FORM_RATE_LIMIT_PER_MINUTE=30
# Tamaño máximo del JSON recibido (bytes).
MAX_CONTENT_LENGTH=1048576

# true SOLO si el servidor está detrás de un proxy (Nginx, Render, Railway,
# Cloudflare...). Así el rate limit y el bloqueo del login usan la IP real del
# visitante y no la del proxy.
TRUST_PROXY=false
# true cuando el dominio ya funcione con HTTPS (candado). Obliga a usar HTTPS.
ENABLE_HSTS=false

# Con el "Transaction pooler" de Supabase (puerto 6543) dejar vacío.
DATABASE_PREPARE_THRESHOLD=
# Segundos que se reutilizan las respuestas públicas (catálogo, reseñas).
API_CACHE_TTL=30
