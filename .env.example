# ==============================================================================
# CONFIGURACIÓN DEL ENTORNO: MANIQUÍ STUDIO
# ==============================================================================

# Configuración del Servidor
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Base de datos PostgreSQL (Supabase)
# Copia la cadena "Session pooler" desde Supabase > Connect. Nunca subas el
# valor real a Git ni lo expongas al frontend.
DATABASE_URL=postgresql://postgres.PROJECT_REF:TU_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSLMODE=require
# Limita las conexiones que este proceso abre contra Supabase.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=5
DATABASE_POOL_TIMEOUT=10

# Seguridad
# Para el frontend servido por este mismo backend no hace falta CORS. Si hay un
# frontend en otro dominio, escribe únicamente sus orígenes separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MINUTE=120
MAX_CONTENT_LENGTH=10485760

# Secretos del backend: genera valores propios para cada entorno.
SESSION_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_LARGO
ADMIN_SALT=REEMPLAZAR_CON_SALT_UNICO
ADMIN_PASSWORD_HASH=REEMPLAZAR_CON_HASH_PBKDF2

# Datos Legales y Comerciales
COMPANY_NAME=MANIQUÍ STUDIO S.A.C.
COMPANY_TAX_ID=RUC: 20608945123
COMPANY_ADDRESS=Av. La Moda 1420, San Isidro, Lima - Perú
COMPANY_EMAIL=contacto@maniquistudio.com
COMPANY_PHONE=+51 (01) 456-7890
